rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Ist der User eingeloggt?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Ist der aktuelle User Admin?
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Ist es das eigene Dokument?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Jeder eingeloggte User darf die users Collection lesen
      // (nötig für Username-Prüfung und Admin-Liste)
      allow read: if isSignedIn();

      // Eigenes Profil erstellen (bei Registrierung)
      allow create: if isSignedIn() && 
                       request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.role in ['admin', 'user'];

      // Eigenes Profil aktualisieren ODER Admin darf Rollen ändern
      allow update: if isOwner(userId) || isAdmin();

      // Nur Admins dürfen Profile löschen
      allow delete: if isAdmin();
    }
  }
}
